# my_diag/.clang-format
# Based on the actual style of the BusyBox source tree
#   modeline: vi: set sw=4 ts=4:
#   Evidence: coreutils/df.c, procps/top.c, procps/ps.c all indent with \t
#
# This file overrides the root .clang-format and applies only to my_diag/.

BasedOnStyle: LLVM

# --- Indentation ---
# BusyBox modeline ts=4 sw=4: tab displays as 4 columns, one tab per indent level
IndentWidth:              4
TabWidth:                 4
UseTab:                   Always
ContinuationIndentWidth:  4

# --- Line width ---
# BusyBox source lines P99 ~= 80; usage strings are an exception but not formatted
ColumnLimit: 80

# --- Brace style (Linux kernel style) ---
# Function definitions: opening brace on its own line
# Control structures (if/for/while): opening brace on the same line
BreakBeforeBraces: Linux

# --- Short forms ---
# BusyBox does not use single-line if; the body always goes on a new line or uses braces
AllowShortIfStatementsOnASingleLine: Never
AllowShortLoopsOnASingleLine:        false
AllowShortFunctionsOnASingleLine:    None
AllowShortBlocksOnASingleLine:       Never

# --- Pointer alignment (Linux/BusyBox convention) ---
# int *p;  not  int* p;
PointerAlignment:   Right
ReferenceAlignment: Right

# --- Spaces ---
SpaceBeforeParens:    ControlStatements
SpaceAfterCStyleCast: true
SpacesInParentheses:  false
SpacesInSquareBrackets: false

# --- Function argument wrapping ---
# BinPack=false: either all on the same line or one per line; no arbitrary packing
BinPackArguments:  false
BinPackParameters: false
AllowAllArgumentsOnNextLine:              true
AllowAllParametersOfDeclarationOnNextLine: true

# --- Alignment ---
# BusyBox aligns enum members manually; clang-format auto-alignment tends to cause
# large-scale reshuffling, so it is disabled.
AlignConsecutiveAssignments:  false
AlignConsecutiveDeclarations: false
AlignTrailingComments:        true

# --- Include sorting ---
# BusyBox has a fixed include order (libbb.h must come last); disable auto-sort
SortIncludes: Never

# --- Misc ---
ReflowComments:      false
MaxEmptyLinesToKeep: 1
